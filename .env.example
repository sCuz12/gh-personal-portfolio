# Optional. When absent, the portfolio uses src/data/portfolio.js.
NEXT_PUBLIC_PORTFOLIO_API_URL=https://api.example.com

# Sanity Brain content. The public site still builds with an empty Brain when omitted.
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-01-01
NEXT_PUBLIC_SITE_URL=https://your-domain.example
NEXT_PUBLIC_SANITY_STUDIO_URL=https://your-studio.sanity.studio

# Server-only viewer token used exclusively for authenticated draft previews.
SANITY_API_READ_TOKEN=

NEXT_PUBLIC_GOOGLE_ANALYTICS_ID = 